import { ScrollView, LineEdit, ComboBox, TextEdit, CheckBox } from "std-widgets.slint";

export struct FieldData {
    key: string,
    label: string,
    hint: string,
    placeholder: string,
    value: string,
    kind: int,
    choices: [string],
    choice: int,
    group: string,
    show-group: bool,
}

global Colors {
    out property <color> background: #0c111b;
    out property <color> panel: #121b28;
    out property <color> border: #253246;
    out property <color> text: #e8edf5;
    out property <color> muted: #91a2b8;
    out property <color> mint: #71e6c6;
}

component Action inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked;
    height: 36px;
    preferred-width: 72px;
    border-radius: 7px;
    border-width: primary ? 0px : 1px;
    border-color: selected ? #497b74 : Colors.border;
    background: !enabled ? #1b2533 : primary ? (touch.has-hover ? #9aefd7 : Colors.mint) : danger ? (touch.has-hover ? #63363f : #3e252f) : selected ? #203d3e : (touch.has-hover ? #243347 : #172232);
    opacity: enabled ? 1 : 0.7;
    Text {
        text: root.label;
        color: !root.enabled ? #91a2b8 : root.primary ? #0e2927 : root.selected ? Colors.mint : Colors.text;
        font-size: 12px;
        font-weight: root.primary ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Navigation inherits Rectangle {
    in property <string> number;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 44px;
    border-radius: 7px;
    background: selected ? #203936 : touch.has-hover ? #192536 : transparent;
    if selected: Rectangle { x: 0px; y: 12px; width: 3px; height: 20px; border-radius: 2px; background: Colors.mint; }
    HorizontalLayout {
        padding-left: 15px;
        padding-right: 12px;
        spacing: 14px;
        Text { text: root.number; font-family: "Consolas"; font-size: 11px; color: root.selected ? Colors.mint : #6c7e96; vertical-alignment: center; width: 18px; }
        Text { text: root.label; font-size: 14px; font-weight: root.selected ? 600 : 400; color: root.selected ? #b6f4e2 : #a3b1c3; vertical-alignment: center; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Param inherits Rectangle {
    in property <FieldData> data;
    in property <bool> enabled: true;
    callback changed(string);
    callback browse(bool);
    min-height: data.show-group ? 144px : 110px;
    background: transparent;
    VerticalLayout {
        spacing: 7px;
        if root.data.show-group: HorizontalLayout {
            height: 26px;
            spacing: 12px;
            Text { text: root.data.group; font-size: 11px; font-weight: 700; color: Colors.mint; vertical-alignment: center; }
            VerticalLayout { alignment: center; Rectangle { height: 1px; background: Colors.border; } }
        }
        HorizontalLayout {
            height: 22px;
            spacing: 10px;
            Text { text: root.data.label; font-size: 13px; font-weight: 600; color: Colors.text; vertical-alignment: center; }
            Text { text: root.data.key == "working_dir" || root.data.key == "environment" || root.data.key == "extra_args" ? "" : "--" + root.data.key; font-family: "Consolas"; font-size: 10px; color: #8092aa; horizontal-alignment: right; vertical-alignment: center; }
        }
        if root.data.kind == 1: ComboBox {
            height: 36px;
            enabled: root.enabled;
            model: root.data.choices;
            current-index: root.data.choice;
            selected(value) => { root.changed(value); }
        }
        if root.data.kind == 2: Rectangle {
            height: 36px;
            HorizontalLayout {
                CheckBox {
                    text: self.checked ? "已启用" : "未启用";
                    checked: root.data.value == "true";
                    enabled: root.enabled;
                    toggled => { root.changed(self.checked ? "true" : "false"); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        if root.data.kind != 1 && root.data.kind != 2: HorizontalLayout {
            height: 36px;
            spacing: 7px;
            LineEdit {
                enabled: root.enabled;
                text: root.data.value;
                placeholder-text: root.data.placeholder;
                edited => { root.changed(self.text); }
            }
            if root.data.kind == 3 || root.data.kind == 5: Action { label: "文件…"; width: 66px; enabled: root.enabled; clicked => { root.browse(false); } }
            if root.data.kind == 4 || root.data.kind == 5: Action { label: "目录…"; width: 66px; enabled: root.enabled; clicked => { root.browse(true); } }
        }
        Text { text: root.data.hint; font-size: 11px; color: Colors.muted; wrap: word-wrap; min-height: 32px; }
    }
}

export component MainWindow inherits Window {
    title: "OVMS Studio";
    icon: @image-url("icon.svg");
    preferred-width: 1280px;
    preferred-height: 900px;
    min-width: 1100px;
    min-height: 760px;
    background: Colors.background;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;

    in-out property <int> page: 0;
    in property <string> application-version;
    in property <int> mode: 0;
    in property <[FieldData]> fields;
    in property <[string]> saved-names;
    in property <bool> has-profiles: false;
    in-out property <string> profile-name: "我的模型服务";
    in property <string> page-title: "启动你的模型服务";
    in property <string> page-description: "选择模型、配置推理，一键开放 API。";
    in property <string> command-preview;
    in property <string> validation-error;
    in property <string> service-state: "尚未启动";
    in property <string> state-detail: "完成配置后，点击启动服务。";
    in property <string> health-detail: "就绪检查将在启动后运行";
    in property <string> process-info: "无运行中的进程";
    in property <string> rest-endpoint: "http://127.0.0.1:8000";
    in property <string> grpc-endpoint: "127.0.0.1:9000";
    in property <string> api-path: "/v2/models/{model}/infer";
    in property <string> model-label: "my-model";
    in property <string> task-label: "传统推理 / 自动识别";
    in property <string> device-label: "CPU";
    in property <string> log-text;
    in property <string> help-text: "正在检测应用内置的 OVMS 版本与完整启动参数…";
    in property <string> runtime-version: "内置 OVMS 2026.4.1 · 无需配置运行时路径";
    in property <string> toast: "准备就绪";
    in property <bool> running: false;
    in property <bool> ready: false;
    in property <bool> failed: false;
    in property <bool> rest-enabled: true;
    in property <bool> inspecting: false;
    in property <bool> dialog-busy: false;
    in-out property <bool> follow-logs: true;

    callback navigate(int);
    callback name-changed(string);
    callback field-changed(string, string);
    callback mode-changed(int);
    callback browse(string, bool);
    callback start-server;
    callback stop-server;
    callback inspect-runtime;
    callback save-profile(string);
    callback load-profile(string);
    callback import-profile;
    callback export-profile;
    callback filter-changed(string);
    callback copy-value(string);
    callback open-url(string);
    callback clear-logs;
    callback export-logs;
    callback apply-preset(int);

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 196px;
            background: #101824;
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                HorizontalLayout {
                    height: 64px;
                    spacing: 10px;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 10px;
                        background: Colors.mint;
                        Text { text: "ov"; font-size: 20px; font-weight: 800; color: #12342f; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    VerticalLayout {
                        spacing: 1px;
                        padding-top: 4px;
                        padding-bottom: 20px;
                        Text { text: "OVMS"; font-size: 18px; font-weight: 750; color: Colors.text; }
                        Text { text: "S T U D I O"; font-size: 9px; color: Colors.muted; }
                    }
                }
                Text { text: "WORKSPACE"; font-size: 9px; font-weight: 600; color: #63768e; height: 27px; vertical-alignment: center; }
                Navigation { number: "01"; label: "模型与来源"; selected: root.page == 0; clicked => { root.navigate(0); } }
                Navigation { number: "02"; label: "服务与网络"; selected: root.page == 1; clicked => { root.navigate(1); } }
                Navigation { number: "03"; label: "推理与性能"; selected: root.page == 2; clicked => { root.navigate(2); } }
                Navigation { number: "04"; label: "高级参数"; selected: root.page == 3; clicked => { root.navigate(3); } }
                Navigation { number: "05"; label: "运行日志"; selected: root.page == 4; clicked => { root.navigate(4); } }
                Navigation { number: "06"; label: "运行时帮助"; selected: root.page == 5; clicked => { root.navigate(5); } }
                Rectangle { height: 1px; background: Colors.border; }
                Text { text: "快速配置"; font-size: 10px; color: #6c7e96; height: 25px; vertical-alignment: center; }
                Action { label: "文本生成 / LLM"; enabled: !root.running; clicked => { root.apply-preset(0); } }
                Action { label: "Embedding 向量"; enabled: !root.running; clicked => { root.apply-preset(1); } }
                Action { label: "传统推理模型"; enabled: !root.running; clicked => { root.apply-preset(2); } }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 92px;
                    border-width: 1px;
                    border-color: Colors.border;
                    border-radius: 8px;
                    background: #141f2d;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 5px;
                        Text { text: "Intel® OpenVINO™"; font-size: 11px; color: Colors.text; }
                        Text { text: "内置 OVMS 2026.4.1"; font-size: 10px; color: Colors.muted; }
                        Text { text: "开箱即用 · 本机推理"; font-size: 9px; color: #668d8a; }
                    }
                }
                Action { label: "官方文档 ↗"; clicked => { root.open-url("docs"); } }
            }
        }
        Rectangle { width: 1px; background: #203044; }
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 99px;
                background: #101722;
                HorizontalLayout {
                    padding-left: 26px;
                    padding-right: 24px;
                    spacing: 20px;
                    VerticalLayout {
                        padding-top: 23px;
                        padding-bottom: 20px;
                        spacing: 7px;
                        Text { text: root.page-title; font-size: 25px; font-weight: 700; color: Colors.text; }
                        Text { text: root.page-description; font-size: 11px; color: Colors.muted; }
                    }
                    VerticalLayout {
                        width: 116px;
                        alignment: center;
                        Rectangle {
                            height: 29px;
                            border-radius: 15px;
                            background: #19352f;
                            border-width: 1px;
                            border-color: #285348;
                            Text { text: "●  LOCAL  /  本机"; font-family: "Microsoft YaHei UI"; font-size: 10px; font-weight: 600; color: Colors.mint; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Colors.border; }
            HorizontalLayout {
                padding: 20px;
                spacing: 18px;
                VerticalLayout {
                    spacing: 13px;
                    Rectangle {
                        height: 62px;
                        background: Colors.panel;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: Colors.border;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 8px;
                            LineEdit { text <=> root.profile-name; placeholder-text: "为配置命名"; enabled: !root.running; min-width: 80px; edited(value) => { root.name-changed(value); } }
                            Action { label: "保存配置"; enabled: !root.dialog-busy; clicked => { root.save-profile(root.profile-name); } }
                            Action { label: "导入"; width: 48px; enabled: !root.running && !root.dialog-busy; clicked => { root.import-profile(); } }
                            Action { label: "导出"; width: 48px; enabled: !root.dialog-busy; clicked => { root.export-profile(); } }
                        }
                    }
                    if root.has-profiles: ComboBox { height: 34px; enabled: !root.running; model: root.saved-names; selected(value) => { root.load-profile(value); } }
                    if root.page == 0: HorizontalLayout {
                        height: 37px;
                        spacing: 7px;
                        Action { label: "本地模型"; selected: root.mode == 0; enabled: !root.running; clicked => { root.mode-changed(0); } }
                        Action { label: "Hugging Face"; selected: root.mode == 1; enabled: !root.running; clicked => { root.mode-changed(1); } }
                        Action { label: "多模型 config.json"; selected: root.mode == 2; enabled: !root.running; clicked => { root.mode-changed(2); } }
                    }
                    if root.page == 3: LineEdit { height: 36px; placeholder-text: "搜索高级参数，例如 cache、CORS、日志…"; edited => { root.filter-changed(self.text); } }
                    if root.page < 4: Rectangle {
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: Colors.border;
                        background: Colors.panel;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: 18px;
                                spacing: 10px;
                                for field in root.fields: Param {
                                    data: field;
                                    enabled: !root.running && !root.dialog-busy;
                                    changed(value) => { root.field-changed(field.key, value); }
                                    browse(folder) => { root.browse(field.key, folder); }
                                }
                                if root.fields.length == 0: Text { text: root.mode == 2 && root.page == 2 ? "多模型推理参数由 config.json 中各模型分别定义。" : "没有匹配的参数"; color: Colors.muted; font-size: 13px; wrap: word-wrap; min-height: 60px; }
                            }
                        }
                    }
                    if root.page == 4: Rectangle {
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: Colors.border;
                        background: #0c131d;
                        // Follow after layout has settled, including the first time this
                        // page is opened with existing logs. No focus is stolen.
                        Timer {
                            interval: 150ms;
                            running: root.follow-logs;
                            triggered => { log-view.set-selection-offsets(2147483647, 2147483647); }
                        }
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            HorizontalLayout {
                                height: 32px;
                                Text { text: "CONSOLE"; font-family: "Consolas"; font-size: 11px; font-weight: 700; color: Colors.mint; vertical-alignment: center; }
                                CheckBox {
                                    text: "跟随日志"; checked <=> root.follow-logs;
                                    toggled => { if self.checked { log-view.set-selection-offsets(2147483647, 2147483647); } }
                                }
                                Action { label: "复制"; width: 50px; height: 30px; clicked => { root.copy-value("logs"); } }
                                Action { label: "导出"; width: 50px; height: 30px; enabled: !root.dialog-busy; clicked => { root.export-logs(); } }
                                Action { label: "清空"; width: 50px; height: 30px; clicked => { root.clear-logs(); } }
                            }
                            log-view := TextEdit {
                                text: root.log-text; read-only: true; font-family: "Consolas"; font-size: 11px; wrap: word-wrap;
                            }
                        }
                    }
                    if root.page == 5: Rectangle {
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: Colors.border;
                        background: Colors.panel;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Text { text: root.runtime-version; font-size: 12px; color: Colors.mint; wrap: word-wrap; min-height: 28px; }
                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                Action { label: root.inspecting ? "正在检测…" : "重新检测内置 OVMS"; enabled: !root.inspecting; clicked => { root.inspect-runtime(); } }
                            }
                            TextEdit { text: root.help-text; read-only: true; font-family: "Consolas"; font-size: 11px; wrap: word-wrap; }
                        }
                    }
                    Rectangle {
                        height: 132px;
                        background: #0e1722;
                        border-width: 1px;
                        border-color: Colors.border;
                        border-radius: 9px;
                        VerticalLayout {
                            padding: 13px;
                            spacing: 8px;
                            HorizontalLayout {
                                height: 25px;
                                Text { text: "$_  启动命令"; font-size: 11px; font-weight: 600; color: Colors.muted; vertical-alignment: center; }
                                Text { text: "参数直接传入 OVMS"; font-size: 9px; color: #62758c; horizontal-alignment: right; vertical-alignment: center; }
                                Action { label: "复制"; width: 50px; height: 25px; clicked => { root.copy-value("command"); } }
                            }
                            TextEdit { text: root.command-preview; read-only: true; font-family: "Consolas"; font-size: 10px; wrap: word-wrap; }
                        }
                    }
                }
                Rectangle {
                    width: 287px;
                    background: Colors.panel;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Colors.border;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 9px;
                        Text { text: "SERVER ENDPOINT"; font-family: "Consolas"; font-size: 10px; font-weight: 700; color: #70859c; height: 18px; }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            Rectangle { width: 9px; height: 9px; border-radius: 5px; background: root.ready ? Colors.mint : root.failed ? #f4979a : root.running ? #f0c778 : #5b6a7e; }
                            Text { text: root.service-state; color: Colors.text; font-size: 23px; font-weight: 700; vertical-alignment: center; }
                        }
                        Text { text: root.state-detail; font-size: 11px; color: Colors.muted; wrap: word-wrap; min-height: 32px; max-height: 48px; overflow: elide; }
                        Text { text: root.process-info; font-family: "Consolas"; font-size: 10px; color: #6f839b; height: 16px; }
                        Rectangle { height: 1px; background: Colors.border; }
                        VerticalLayout {
                            spacing: 9px;
                            Text { text: "当前模型"; font-size: 10px; color: #71859e; }
                            Text { text: root.model-label; font-size: 16px; font-weight: 600; color: Colors.text; overflow: elide; }
                            HorizontalLayout {
                                spacing: 7px;
                                Rectangle { height: 24px; width: 61px; border-radius: 5px; background: #26394a; Text { text: root.device-label; font-family: "Consolas"; font-size: 10px; color: #b8d9ec; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } }
                                Text { text: root.task-label; font-size: 10px; color: Colors.muted; vertical-alignment: center; overflow: elide; }
                            }
                        }
                        Rectangle { height: 1px; background: Colors.border; }
                        VerticalLayout {
                            spacing: 9px;
                            HorizontalLayout {
                                Text { text: "REST / HTTP"; font-family: "Consolas"; font-size: 10px; color: #71859e; vertical-alignment: center; }
                                Action { label: "复制"; width: 45px; height: 23px; enabled: root.rest-enabled; clicked => { root.copy-value("endpoint"); } }
                            }
                            Text { text: root.rest-endpoint; font-family: "Consolas"; font-size: 12px; color: Colors.mint; wrap: word-wrap; min-height: 17px; }
                            Text { text: root.api-path; font-family: "Consolas"; font-size: 10px; color: #7b9eac; wrap: word-wrap; min-height: 25px; }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            Text { text: "gRPC"; font-family: "Consolas"; font-size: 10px; color: #71859e; }
                            Text { text: root.grpc-endpoint; font-family: "Consolas"; font-size: 12px; color: #b1c0d2; wrap: word-wrap; min-height: 18px; }
                        }
                        Rectangle {
                            min-height: 69px;
                            background: root.ready ? #142e2d : #182536;
                            border-radius: 7px;
                            VerticalLayout {
                                padding: 11px;
                                spacing: 5px;
                                Text { text: root.ready ? "✓  就绪检查通过" : "○  服务就绪检查"; font-size: 11px; font-weight: 600; color: root.ready ? Colors.mint : #a3b6cc; }
                                Text { text: root.health-detail; font-family: "Microsoft YaHei UI"; font-size: 10px; color: #819ab0; wrap: word-wrap; min-height: 29px; max-height: 52px; overflow: elide; }
                            }
                        }
                        Rectangle { vertical-stretch: 1; min-height: 0px; }
                        if root.validation-error != "" && !root.running: Text { text: root.validation-error; font-size: 11px; color: #e4bd80; wrap: word-wrap; min-height: 32px; max-height: 62px; overflow: elide; }
                        Action { label: root.running ? "停止服务" : "启动服务"; primary: !root.running; danger: root.running; enabled: root.running || (root.validation-error == "" && !root.dialog-busy); height: 44px; clicked => { if root.running { root.stop-server(); } else { root.start-server(); } } }
                        HorizontalLayout {
                            height: 33px;
                            spacing: 7px;
                            Action { label: "调用示例"; height: 33px; enabled: root.rest-enabled && root.validation-error == ""; clicked => { root.copy-value("example"); } }
                            Action { label: "健康检查 ↗"; height: 33px; enabled: root.ready && root.rest-enabled; clicked => { root.open-url("health"); } }
                        }
                    }
                }
            }
            Rectangle {
                height: 30px;
                background: #101722;
                HorizontalLayout {
                    padding-left: 21px;
                    padding-right: 21px;
                    Text { text: root.toast; font-size: 10px; color: #7d92a9; vertical-alignment: center; overflow: elide; }
                    Text { text: "OVMS STUDIO  /  " + root.application-version; font-family: "Consolas"; font-size: 9px; color: #4d647b; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
        }
    }
}
